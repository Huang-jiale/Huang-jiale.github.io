{#
  点进某个分类之后的那一页（/categories/学习/行测/）：主题的 layout/category.njk 整张顶掉
  —— scripts/cat-tree.js 里 setView('category.njk', …)；hexo-generator-category 取的 layout 名
  就是 ['category', 'archive', 'index']。不改 node_modules 里的文件：Actions 上 pnpm install 会拿回原版。

  上半截和总览页用同一套零件（面包屑 + 一张卡 + 子分类芯片），只是这里只画「本页那一条链」，
  不再画一整棵树：全站最深三层，面包屑最多三个，够定位了。
  下半截是本页的文章列表：主题的 posts-collapse 那套年份表头 + MM-DD 日期不保留
  —— 日期是导入那天写的，读者要的是顺序；顺序由 _config.yml 的 category_generator.order_by: date
  定成升序，所以「第 2 页」接着「第 1 页」往后排，翻页不会乱。
#}
{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}

{% block title %}{{ __('title.category') }}: {{ page.category }} | {{ title }}{% endblock %}

{% block class %}category posts-collapse{% endblock %}

{% block content %}
  {%- set here = cat_here(page) %}
  {%- set n = page.posts.toArray() %}
  <div class="post-block">
    <div class="post-content">
      {%- if here and here.node %}
      {# 一级分类不必画面包屑：只有它自己一个，和下面那张卡的 <h1> 重复 #}
      {%- if here.crumbs.length %}
      <nav class="cat-crumb" aria-label="分类位置">
        {%- for c in here.crumbs %}
        <a class="cat-crumb-item" href="{{ url_for(c.url) }}">{{ c.name }}</a>
        <span class="cat-crumb-sep" aria-hidden="true">›</span>
        {%- endfor %}
        <b class="cat-crumb-here">{{ here.node.name }}</b>
      </nav>
      {%- endif %}

      <article class="cat-card cat-card--here">
        <h1 class="cat-card-head">{{ here.node.name }}<span class="cat-card-num">{{ here.node.count }} 篇</span></h1>
        {%- if here.node.children.length %}
        <ul class="cat-kids">
          {%- for leaf in here.node.children %}
          <li><a class="cat-kid" href="{{ url_for(leaf.url) }}">{{ leaf.name }}<span class="cat-kid-num">{{ leaf.count }}</span></a></li>
          {%- endfor %}
        </ul>
        {%- endif %}
      </article>
      {%- else %}
      <div class="collection-title">
        <h1 class="collection-header">{{ page.category }}<small>{{ __('title.category') }}</small></h1>
      </div>
      {%- endif %}

      <p class="cat-list-note">
        {%- if here and here.node and here.node.children.length %}
        下面 {{ here.node.children.length }} 个子分类、共 {{ here.node.count }} 篇；
        {%- else %}
        {# 「共」是这一类的总数（翻页翻完的那些），不是本页这一屏的条数 #}
        共 {{ here.node.count if here and here.node else n.length }} 篇；
        {%- endif %}
        这一页列 {{ n.length }} 篇，按日期先后排。
      </p>
      <ul class="cat-posts">
        {%- for post in n %}
        <li><a href="{{ url_for(post.path) }}">{{ post.title }}</a></li>
        {%- endfor %}
      </ul>

      {%- include '_partials/pagination.njk' -%}
    </div>
  </div>
{% endblock %}

{% block sidebar %}
  {{ sidebar_template.render(false) }}
{% endblock %}
