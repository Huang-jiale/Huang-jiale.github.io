// ============================================================
// 站点样式覆盖（NexT 官方钩子：_config.next.yml 的 custom_file_path.style）
//
// main.styl 的最后一层是 `for $inject_style in hexo-config('injects.style')`，
// 所以这里排在主题所有样式之后：同优先级的规则这里写就赢，不需要 !important。
// 设计目标是「苹果那套」：层级靠字重和留白、色块代替分割线、大圆角 + 两级阴影、单一强调色。
//
// 颜色这类无逗号 token 用 CSS 自定义属性（:root + 深色媒体查询）；
// 阴影这类带逗号的值一律写成 Stylus 变量再落到属性上，避免 Stylus 解析自定义属性里的逗号。
// ============================================================

:root {
  --ink: #1d1d1f;          // 标题、需要压住一切的正文
  --ink-soft: #424245;     // 正文
  --muted: #86868b;        // 次要信息：时间、分类、说明
  --hairline: #e8e8ed;     // 只用于表格和输入框，不再当卡片分割线
  --surface: #ffffff;      // 卡片
  --surface-2: #f5f5f7;    // 卡片内的次级色块、hover 底
  --accent: #0071e3;
  --accent-ink: #ffffff;
  --radius-lg: 20px;
  --radius-md: 14px;
  --radius-pill: 980px;
  --ease: cubic-bezier(.25, .1, .25, 1);
  --heat-0: #f2f2f5;      // 日历五档：没入库 / 少 / 略多 / 多 / 峰值那档用 --accent
  --heat-1: #d6e9fb;
  --heat-2: #a3cdf3;
  --heat-3: #4f9fe0;
  --heat-future: #fafafb; // 还没到的那几天，比空格子更淡一档
}

if (hexo-config('darkmode')) {
  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #f5f5f7;
      --ink-soft: #d2d2d7;
      --muted: #98989d;
      --hairline: #38383a;
      --surface: #1c1c1e;
      --surface-2: #2c2c2e;
      --accent: #6cb6ff;
      --accent-ink: #000000;
      --heat-0: #2c2c2e;
      --heat-1: #1e3a55;
      --heat-2: #2a5f8f;
      --heat-3: #3f87c9;
      --heat-future: #232326;
    }
  }
}

// 深色下主题的浅阴影看不见，卡片改用重阴影（选择器与主题 _schemes/Pisces 里的三块卡片对齐）
if (hexo-config('darkmode')) {
  @media (prefers-color-scheme: dark) {
    header.header {
      box-shadow: $shadow-dark;
    }

    .main-inner {
      box-shadow: $shadow-dark;
    }

    +desktop() {
      .sidebar-inner {
        box-shadow: $shadow-dark;
      }
    }
  }
}

// ---------------------------------------------------------------
// 排版基座：字体平滑、数字等宽、链接去掉那条下边框
// ---------------------------------------------------------------
body {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  -webkit-tap-highlight-color: transparent;
  text-rendering: optimizeLegibility;
}

a {
  border-bottom: 0;
  transition: color $transition-ease;

  &:hover {
    border-bottom-color: transparent;
  }
}

h1, h2, h3, h4, h5, h6 {
  color: var(--ink);
  font-weight: 600;
  letter-spacing: -.014em;
}

// ---------------------------------------------------------------
// 卡片外观：主内容区 / 侧栏 / 头部三块圆角卡，去掉 post-eof 那条分割线
// ---------------------------------------------------------------
.post-eof {
  display: none;
}

.post-block:first-of-type {
  padding-top: 0;
}

// ---------------------------------------------------------------
// 头部：原来是一整块饱和色 banner（--theme-color 底 + 白字），换成干净的左对齐标题
// ---------------------------------------------------------------
.site-brand-container {
  background: transparent;
}

.site-meta {
  padding: 22px 20px 10px;
  text-align: left;
}

.brand {
  color: var(--ink);

  &:hover {
    color: var(--accent);
  }

  .logo-line {
    display: none;   // 标题两侧那两道装饰斜线
  }
}

.site-title {
  font-size: 1.125em;
  font-weight: 600;
  letter-spacing: -.02em;
}

.site-subtitle {
  color: var(--muted);
  margin: 4px 0 0;
  text-align: left;
}

.site-nav-toggle .toggle, .site-nav-right .toggle {
  color: var(--ink);

  .toggle-line {
    background: currentColor;
  }
}

// 菜单：竖排胶囊项，选中/hover 用次级色块，不靠小圆点
.menu {
  padding: 0 12px 12px;
}

.menu .menu-item {
  margin: 2px 0;

  a {
    border-radius: var(--radius-pill);
    color: var(--ink-soft);
    font-size: .9375em;
    font-weight: 500;
    padding: 7px 14px;
    transition: background-color $transition-ease, color $transition-ease;

    &:hover, &.menu-item-active {
      background: var(--surface-2);
      color: var(--ink);
    }
  }

  .badge {
    background: var(--hairline);
    border-radius: var(--radius-pill);
    color: var(--muted);
    text-shadow: none;
  }
}

// ---------------------------------------------------------------
// 文章页：标题左对齐、去掉 hover 划线动画，正文层级靠字重与留白
// ---------------------------------------------------------------
.posts-expand {
  .post-header {
    margin-bottom: 32px;
    text-align: left;
  }

  .post-title {
    font-size: 1.9em;
    font-weight: 600;
    line-height: 1.25;
  }

  .post-title-link {
    color: var(--ink);

    &::before {
      display: none;
    }

    &:hover {
      color: var(--accent);
    }
  }
}

.post-meta {
  color: var(--muted);
  font-feature-settings: 'tnum' 1;
  font-variant-numeric: tabular-nums;

  a {
    color: var(--muted);

    &:hover {
      color: var(--accent);
    }
  }
}

.post-body {
  color: var(--ink-soft);

  p {
    margin: 0 0 1.2em;
  }

  h2 {
    margin: 2.2em 0 .8em;
  }

  h3, h4 {
    margin: 1.8em 0 .6em;
  }

  > :first-child {
    margin-top: 0;
  }

  img, video {
    border-radius: var(--radius-md);
    margin-bottom: 16px;
  }

  table {
    font-feature-settings: 'tnum' 1;
    font-variant-numeric: tabular-nums;

    th {
      color: var(--muted);
      font-weight: 600;
    }
  }

  blockquote {
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--muted);
    padding: 12px 20px;
  }

  // 正文里的链接：静止不下划线，hover 才出现，颜色本身就是可点击的提示
  a {
    color: var(--accent);

    &:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
}

// 按钮（阅读全文、提交等）：胶囊 + 轻微上浮
.post-button {
  margin-top: 20px;
}

.btn, .post-button .btn {
  border-radius: var(--radius-pill);
  font-weight: 500;
  letter-spacing: -.01em;
  padding: 9px 22px;
  transition: background-color $transition-ease, box-shadow $transition-ease, transform $transition-ease;

  &:hover {
    box-shadow: 0 6px 18px rgba(0, 113, 227, .28);
    transform: translateY(-1px);
  }
}

.pagination {
  a, .page-number {
    border-color: transparent;
    border-radius: var(--radius-pill);
    transition: background-color $transition-ease, color $transition-ease;
  }

  a:hover {
    background: var(--surface-2);
    border-color: transparent;
  }

  .page-number.current {
    background: var(--accent);
    color: var(--accent-ink);
  }
}

// ---------------------------------------------------------------
// 移动端头部：吸顶 + 毛玻璃（桌面端头部是左栏里的一张卡，不动它，避免盖住正文）
// ---------------------------------------------------------------
+tablet-mobile() {
  header.header {
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    background: rgba(255, 255, 255, .78);
    border-radius: 0;
    position: sticky;
    top: 0;
    z-index: $zindex-3;
  }
}

if (hexo-config('darkmode')) {
  @media (prefers-color-scheme: dark) {
    +tablet-mobile() {
      header.header {
        background: rgba(28, 28, 30, .78);
      }
    }
  }
}

// ---------------------------------------------------------------
// 行测「点击揭晓答案」：details 折叠，静止时只有一颗胶囊，展开后是次级色块
// ---------------------------------------------------------------
details.answer {
  margin: 0 0 1.4em;

  // 折叠按钮的文案来自 HTML 里的 <summary>，CSS 不再 ::before 补字，免得两处对不上
  > summary {
    background: var(--surface-2);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    color: var(--muted);
    cursor: pointer;
    display: inline-block;
    font-size: .875em;
    font-weight: 500;
    list-style: none;
    padding: 5px 14px;
    transition: background-color $transition-ease, border-color $transition-ease, color $transition-ease;
    user-select: none;
    -webkit-user-select: none;

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-ink);
    }
  }

  &[open] > summary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  // Chrome 靠 `::details-content { content-visibility: hidden }` 隐藏折叠内容：布局盒子还在，
  // 只是不画（getBoundingClientRect 会量到高度，checkVisibility() 才是 false）。
  // 这里显式 display:none，一是换掉那个占位盒子，二是让不支持该伪元素的内核也真的藏住。
  > .answer-body {
    display: none;
  }

  &[open] > .answer-body {
    display: block;
  }

  .answer-body {
    background: var(--surface-2);
    border-radius: var(--radius-md);
    margin-top: 10px;
    padding: 14px 18px;

    p:last-child {
      margin-bottom: 0;
    }
  }
}

// ---------------------------------------------------------------
// 首页 Bento 栅格（数据 scripts/bento-home.js，模板 tools/bento-home.njk）
// 只在首页这一块作用域里，卡片之间靠网格与色差分格，卡内不再画分割线
// ---------------------------------------------------------------
.bento-grid {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(6, 1fr);
}

.bento-card {
  background: var(--surface-2);
  border-radius: var(--radius-lg);
  grid-column: span 2;
  padding: 26px;
  transition: transform $transition-ease, box-shadow $transition-ease;

  &:hover {
    box-shadow: $shadow-float;
    transform: translateY(-2px);
  }
}

// 热力图与「最近更新」都整行铺；三张模块卡一行三张
.bento-card--heat,
.bento-card--feed {
  grid-column: span 6;
}

.bento-card--empty {
  background: transparent;
  border: 1px dashed var(--hairline);

  .bento-name {
    color: var(--muted);
  }

  &:hover {
    box-shadow: none;
    transform: none;
  }
}

.bento-kicker {
  color: var(--muted);
  font-feature-settings: 'tnum' 1;
  font-size: .8125em;
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  letter-spacing: .02em;
  margin: 0 0 8px;
}

.bento-name {
  font-size: 1.3em;
  margin: 0;

  a {
    color: var(--ink);

    &:hover {
      color: var(--accent);
    }
  }
}

.bento-blurb {
  color: var(--ink-soft);
  font-size: .9375em;
  line-height: 1.7;
  margin: 10px 0 0;
}

// ---------------------------------------------------------------
// 首页 GitHub 式日历：52 列 × 7 行，一格一天，周一在第一行
// 纯 CSS 静态渲染（数据 scripts/bento-home.js、模板 tools/bento-home.njk），没有 JS 和动画。
// 只读：不链到归档，悬停出「日期 · 篇数 · 模块」的原生 title。
// ---------------------------------------------------------------
.heat-scroll {
  // 52 列在窄屏放不进，让它横向滚而不是把格子压成一条线
  overflow-x: auto;
  padding-bottom: 4px;
}

// 月首标签和格子用同一个 52 列网格，才能对齐到那一列的头上
.heat-months {
  display: grid;
  grid-template-columns: repeat(52, minmax(11px, 1fr));
  gap: 3px;
  height: 16px;
}

.heat-month {
  color: var(--muted);
  font-feature-settings: 'tnum' 1;
  font-size: .6875em;
  line-height: 16px;
  white-space: nowrap;
}

.heat-grid {
  display: grid;
  // 竖着填：模板按「一周 7 格」的顺序输出，所以每一列自动就是一周
  grid-auto-flow: column;
  grid-template-columns: repeat(52, minmax(11px, 1fr));
  grid-template-rows: repeat(7, 11px);
  gap: 3px;
}

.heat-cell {
  border-radius: 2px;
  display: block;
  height: 11px;
  width: 100%;
}

.heat-l0 {
  background: var(--heat-0);
}

.heat-l1 {
  background: var(--heat-1);
}

.heat-l2 {
  background: var(--heat-2);
}

.heat-l3 {
  background: var(--heat-3);
}

.heat-l4 {
  background: var(--accent);
}

.heat-cell.is-future {
  background: var(--heat-future);
}

.heat-foot {
  align-items: center;
  color: var(--muted);
  display: flex;
  flex-wrap: wrap;
  font-feature-settings: 'tnum' 1;
  font-size: .75em;
  gap: 8px;
  justify-content: space-between;
  margin-top: 12px;
}

.heat-legend {
  align-items: center;
  display: inline-flex;
  gap: 3px;

  // 图例里那五格是 flex 子项，.heat-cell 的 width:100% 会变成「占满整行」
  .heat-cell {
    width: 10px;
  }
}

.bento-kids {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  list-style: none;
  margin: 16px 0 0;
  padding: 0;

  a {
    align-items: center;
    background: var(--surface);
    border-radius: var(--radius-pill);
    color: var(--ink-soft);
    display: inline-flex;
    font-size: .875em;
    font-weight: 500;
    gap: 7px;
    padding: 5px 13px;
    transition: background-color $transition-ease, color $transition-ease;

    &:hover {
      background: var(--accent);
      color: var(--accent-ink);

      .bento-count {
        color: var(--accent-ink);
        opacity: .75;
      }
    }
  }
}

.bento-count {
  color: var(--muted);
  font-feature-settings: 'tnum' 1;
  font-size: .8125em;
  font-variant-numeric: tabular-nums;
}

.bento-more {
  align-items: center;
  color: var(--accent);
  display: inline-flex;
  font-size: .9375em;
  font-weight: 500;
  gap: 7px;
  margin-top: 18px;

  i {
    font-size: .8em;
  }
}

.bento-feed {
  list-style: none;
  margin: 10px 0 0;
  padding: 0;

  li {
    align-items: baseline;
    border-bottom: 1px solid var(--hairline);
    display: grid;
    gap: 14px;
    grid-template-columns: 48px 1fr auto;
    padding: 11px 0;
  }

  li:last-child {
    border-bottom: 0;
  }

  time {
    color: var(--muted);
    font-feature-settings: 'tnum' 1;
    font-size: .8125em;
    font-variant-numeric: tabular-nums;
  }
}

.bento-feed-title {
  color: var(--ink);
  font-weight: 500;
  overflow-wrap: break-word;

  &:hover {
    color: var(--accent);
  }
}

.bento-tag {
  background: var(--surface);
  border-radius: var(--radius-pill);
  color: var(--muted);
  font-size: .75em;
  padding: 2px 9px;
  white-space: nowrap;
}

+tablet-mobile() {
  .bento-grid {
    grid-template-columns: 1fr;
  }

  .bento-card, .bento-card--heat, .bento-card--feed {
    grid-column: auto;
    grid-row: auto;
    padding: 22px;
  }

  // 手机上格子缩到最小一档，52 周还是靠横向滑动看，不硬塞进屏宽
  .heat-months, .heat-grid {
    grid-template-columns: repeat(52, 11px);
  }
}

// ---------------------------------------------------------------
// 侧栏目录：课（h2）常显，课内小标题（h3）默认折叠，点课名才展开
// 展开的类 .toc-open 由 source/js/toc-fold.js 加，--height 也是它按真实内容高度写的。
// _config.next.yml 里 toc.expand_all 设成 true，主题那套「滚到哪个课就自动撑开哪个」的
// 折叠 CSS 整块不再输出，所以这里的 .nav-child 是全站唯一一套，不用和主题抢优先级。
// 层级靠字重、缩进和小标题左边那条竖线，不画分割线。
// ---------------------------------------------------------------
.post-toc {
  .nav {
    padding-left: 2px;

    // 长标题换行：主题默认 nowrap + 省略号，240px 的侧栏里一门课的名字只显示半截
    .nav-item {
      line-height: 1.45;
      overflow: visible;
      text-overflow: clip;
      white-space: normal;
    }

    a {
      border-bottom: 0;
      border-radius: 8px;
      color: var(--ink-soft);
      display: block;
      padding: 6px 8px;
      transition: background-color .2s var(--ease), color .2s var(--ease);
    }

    a:hover {
      background: var(--surface-2);
      color: var(--ink);
    }

    // 课
    > .nav-item {
      margin-bottom: 1px;

      > a {
        font-weight: 600;
      }
    }

    .nav-child {
      --height: 0;
      height: 0;
      opacity: 0;
      overflow: hidden;
      transition: height .28s var(--ease), opacity .2s var(--ease), visibility .28s;
      visibility: hidden;
    }

    .toc-open > .nav-child {
      height: var(--height, auto);
      opacity: 1;
      visibility: visible;
    }

    // 小标题：缩进 + 竖线表示「属于上面那门课」
    .nav-child > .nav-item > a {
      border-left: 2px solid var(--hairline);
      border-radius: 0 8px 8px 0;
      color: var(--muted);
      font-size: .95em;
      margin-left: 14px;
      padding: 4px 8px 4px 12px;
    }

    // 箭头：只有带小标题的课才有（JS 给这些条目加 .toc-parent）
    .toc-parent > a {
      padding-left: 22px;
      position: relative;

      &::before {
        border-bottom: 1.6px solid var(--muted);
        border-right: 1.6px solid var(--muted);
        content: '';
        height: 6px;
        left: 8px;
        margin-top: -4px;
        position: absolute;
        top: 50%;
        transform: rotate(-45deg);
        transition: transform .2s var(--ease);
        width: 6px;
      }
    }

    .toc-parent.toc-open > a::before {
      transform: rotate(45deg);
    }

    // 当前读到哪：只换颜色，不再自动撑开（那正是原来侧栏自己跳动的原因）
    .active > a,
    .active-current > a {
      color: var(--accent);
    }

    .nav-child > .active > a {
      background: var(--surface-2);
    }
  }
}

// ---------------------------------------------------------------
// 顶部阅读进度条：主题自带（_config.next.yml 的 reading_progress），
// 颜色跟着 --accent 走，深色模式自动换成浅蓝，不用配置里写死的那个 hex。
// 主题把这个 div 输出在**所有**页面（layout/_partials/head 之外没有判断），首页/分类/归档
// 那条线滚起来毫无意义，所以要按页面类型收掉。开关选 .main-inner.post 而不是 body 上的类：
// 产物里各页 <body> 都是 `class="use-motion"`，区分不了；.main-inner 的第二/三个类
// （post/index/archive/category/tag + posts-expand/posts-collapse）才是每类页面各自的。
// :has() 是「命中祖先的后代」，浏览器都支持了（2023+）。
// ---------------------------------------------------------------
.reading-progress-bar {
  background: var(--accent);
  display: none;
}

body:has(.main-inner.post) .reading-progress-bar {
  display: block;
}

// ---------------------------------------------------------------
// 侧栏「本模块文章」：文章页里把主题的站点概览（作者名 / 日志统计 / GitHub 链接）整块让位，
// 换成当前篇所在模块的兄弟篇（模板 tools/sidebar-module.njk，数据 scripts/module-nav.js）。
// .module-nav 只在文章页渲染出来，所以 :has() 这个条件波及不到首页和分类页；
// 格子标签「站点概览 → 本模块文章」由 source/js/sidebar-module.js 改，判断依据同上。
// ---------------------------------------------------------------
.site-overview-wrap:has(.module-nav) {
  > :not(.module-nav) {
    display: none;
  }
}

.module-nav {
  color: var(--ink-soft);
  font-size: .9375em;
  text-align: left;

  .module-nav-head {
    align-items: baseline;
    display: flex;
    gap: 8px;
    margin: 0 0 10px;
  }

  // 模块名就是该模块的分类页，右下角那颗数字是这一栏的总篇数
  .module-nav-title {
    color: var(--ink);
    font-weight: 600;

    &:hover {
      color: var(--accent);
    }
  }

  .module-nav-count {
    color: var(--muted);
    flex: none;
    font-feature-settings: 'tnum' 1;
    font-size: .85em;
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }

  // 组名（题型 / 月份）：点一下展开，样式跟侧栏目录的课保持一致
  .module-nav-group {
    align-items: baseline;
    background: none;
    border: 0;
    color: var(--muted);
    cursor: pointer;
    display: flex;
    font-family: inherit;
    font-size: .85em;
    letter-spacing: .02em;
    margin-top: 12px;
    padding: 2px 8px;
    width: 100%;

    &:hover {
      color: var(--ink);
    }

    &::before {
      border-bottom: 1.6px solid currentColor;
      border-right: 1.6px solid currentColor;
      content: '';
      flex: none;
      height: 5px;
      margin-right: 8px;
      transform: rotate(-45deg);
      transition: transform .2s var(--ease);
      width: 5px;
    }
  }

  .is-open > .module-nav-group {
    color: var(--ink-soft);

    &::before {
      transform: rotate(45deg);
    }
  }

  .module-nav-list {
    --height: auto;
    height: 0;
    margin: 0;
    overflow: hidden;
    padding-left: 0;
    // visibility 一并收起：收起的组只是看不见了，链接还留在键盘 Tab 顺序里很怪
    transition: height .28s var(--ease), visibility .28s;
    visibility: hidden;

    li {
      list-style: none;
      margin: 0;
    }

    a {
      border-radius: 8px;
      color: var(--ink-soft);
      display: block;
      line-height: 1.45;
      padding: 5px 8px;
      transition: background-color .2s var(--ease), color .2s var(--ease);
    }

    a:hover {
      background: var(--surface-2);
      color: var(--ink);
    }
  }

  .is-open > .module-nav-list {
    height: var(--height);
    visibility: visible;
  }

  // 没有第三层分类的模块（素描）没有组，列表直接挂在 .module-nav 下面，不参与折叠
  > .module-nav-list {
    height: auto;
    visibility: visible;
  }

  // 当前这篇：左边一条竖线 + 强调色，不画分割线
  .module-nav-list .is-current > a {
    background: var(--surface-2);
    border-left: 2px solid var(--accent);
    border-radius: 0 8px 8px 0;
    color: var(--accent);
    font-weight: 600;
    margin-left: 2px;
    padding-left: 14px;
  }
}

// ---------------------------------------------------------------
// 一键到顶：主题自带（_config.next.yml 的 back2top），点击和滚过 5% 才显出来
// 都是 source/js/utils.js 现成的（.back-to-top-on），这里只搬到右下角、放大成圆角按钮。
// 原来它在 desktop 上是 left:30px 的一颗 26px 深灰小块——正好压在 240px 宽的侧栏上，看不见。
// ---------------------------------------------------------------
.back-to-top {
  align-items: center;
  background: var(--surface);
  border: 1px solid var(--hairline);
  border-radius: var(--radius-md);
  bottom: -100px;
  box-shadow: $shadow-soft;
  color: var(--ink-soft);
  height: 42px;
  justify-content: center;
  left: auto;
  opacity: 1;
  right: 30px;
  transition-property: bottom, color, border-color;
  width: 42px;

  &:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  // 主题的居中机制是「图标宽度 = 按钮宽度 26px + text-align:center」，按钮放大到 42px 后
  // 那 26px 就偏左了；居中的活儿交给上面的 justify-content，这里只管字号。
  // .fa-lg 是 1.333em，选择器多写一层才压得住它。
  i.fa {
    font-size: 18px;
    line-height: 1;
    width: auto;
  }
}

.back-to-top.back-to-top-on {
  bottom: 30px;
}

+tablet-mobile() {
  .back-to-top {
    right: 20px;
  }
}

// ---------------------------------------------------------------
// 分类页：树状图（数据 + 模板 scripts/cat-tree.js、tools/cat-tree.njk、tools/cat-branch.njk）
//
// 一行一个分类节点，行高固定 30px，缩进就是层级；父子之间是一条圆角折线（├ / └）。
// 折线的竖段分成上下两半分开画：上半 + 横段是 ::before 的左边框和下边框（拐角再圆一下），
// 下半是 ::after。因为每行等高，「上一行中心 → 本行中心」正好就是 15px + 15px，
// 纯 CSS 就能接准，不用 JS 量位置。
// 组里最后一个节点 (::after 那条继续往下的线) 由模板加 .is-tail 停掉；
// 子孙还要穿过父辈那一竖时，模板另外塞一个 <i class="cat-rail">（只有总览页的第三层会用到）。
// 深色模式不用另写一套：线色走 --hairline、胶囊走 --surface / --accent。
// ---------------------------------------------------------------
.cat-lede {
  align-items: baseline;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 0 0 20px;
}

.cat-lede-strong {
  color: var(--ink);
  font-feature-settings: 'tnum' 1;
  font-size: 1.0625em;
  font-variant-numeric: tabular-nums;
  font-weight: 600;
}

.cat-lede-note {
  color: var(--muted);
  font-size: .875em;
}

// 一张卡 = 一个一级模块；宽屏两列，窄列放不下就自己掉回一列。
// align-items:start：不拉平两列的高度，否则「学习」那张只有 14 行的卡会被撑到 26 行高，底下空一块。
.cat-cards {
  align-items: start;
  display: grid;
  gap: 22px;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
}

.cat-card {
  background: var(--surface-2);
  border-radius: var(--radius-lg);
  overflow-x: auto;
  padding: 18px 20px;
}

.cat-row {
  align-items: center;
  display: flex;
  height: 30px;
  position: relative;
}

.cat-row--l1 {
  padding-left: 22px;
}

.cat-row--l2 {
  padding-left: 44px;
}

// ├─ / └─ 的转角：竖着下来 15px，再横着进胶囊
.cat-row--l1::before,
.cat-row--l2::before {
  border-bottom: 1px solid var(--hairline);
  border-bottom-left-radius: 6px;
  border-left: 1px solid var(--hairline);
  content: '';
  height: 15px;
  position: absolute;
  top: 0;
  width: 11px;
}

.cat-row--l1::before {
  left: 11px;
}

.cat-row--l2::before {
  left: 33px;
}

// 同一组下面还有兄弟：从本行中心再往下 15px，正好接到下一行的转角
.cat-row--l1::after,
.cat-row--l2::after {
  background: var(--hairline);
  content: '';
  height: 15px;
  position: absolute;
  top: 15px;
  width: 1px;
}

.cat-row--l1::after {
  left: 11px;
}

.cat-row--l2::after {
  left: 33px;
}

.cat-row.is-tail::after {
  content: none;
}

// 祖先那一竖要穿过我这行接着往下走
.cat-rail {
  background: var(--hairline);
  height: 30px;
  left: 11px;
  position: absolute;
  top: 0;
  width: 1px;
}

.cat-node {
  align-items: center;
  border: 1px solid transparent;
  border-radius: var(--radius-pill);
  display: inline-flex;
  flex: none;
  font-size: .875em;
  gap: 6px;
  height: 28px;
  line-height: 1;
  padding: 0 11px;
  transition: background-color $transition-ease, color $transition-ease, border-color $transition-ease;
  white-space: nowrap;
}

.cat-num {
  font-feature-settings: 'tnum' 1;
  font-size: .8125em;
  font-variant-numeric: tabular-nums;
  opacity: .62;
}

.cat-node--top {
  background: var(--accent);
  color: var(--accent-ink);
  font-size: .9375em;
  font-weight: 600;
  padding: 0 14px;
}

.cat-node--mod {
  background: var(--surface);
  color: var(--ink);
  font-weight: 600;
}

.cat-node--leaf {
  background: transparent;
  border-color: var(--hairline);
  color: var(--ink-soft);
}

.cat-node--crumb {
  background: transparent;
  border-color: transparent;
  color: var(--muted);
  padding: 0 6px;
}

.cat-node--crumb:hover {
  color: var(--accent);
}

.cat-node--top:hover,
.cat-node--mod:hover,
.cat-node--leaf:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.cat-node--top:hover {
  color: var(--accent-ink);
  opacity: .92;
}

// 分类页的本页标题就是树上那一个节点，所以 <h1> 直接长成胶囊
.cat-node--here {
  background: var(--surface);
  border-color: var(--accent);
  color: var(--ink);
  font-size: 1em;
  font-weight: 600;
  letter-spacing: -.014em;
  margin: 0;
  padding: 0 14px;
}

.cat-list-note {
  color: var(--muted);
  font-feature-settings: 'tnum' 1;
  font-size: .8125em;
  font-variant-numeric: tabular-nums;
  margin: 22px 0 4px;
}

// 文章列表：不写日期（那是导入那天），一行一篇，hover 才出色块
.cat-posts {
  list-style: none;
  margin: 0;
  padding: 0;

  a {
    border-radius: 10px;
    color: var(--ink-soft);
    display: block;
    line-height: 1.5;
    padding: 7px 10px;
    transition: background-color $transition-ease, color $transition-ease;
  }

  a:hover {
    background: var(--surface);
    color: var(--accent);
  }
}

// ---------------------------------------------------------------
// 无障碍：用户要求减少动效时，主题的入场动画（animate.css）直接落到终态
// ---------------------------------------------------------------
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
}
