// ============================================================
// 站点样式覆盖（NexT 官方钩子：_config.next.yml 的 custom_file_path.style）
//
// main.styl 的最后一层是 `for $inject_style in hexo-config('injects.style')`，
// 所以这里排在主题所有样式之后：同优先级的规则这里写就赢，不需要 !important。
// 设计目标是「苹果那套」：层级靠字重和留白、色块代替分割线、大圆角 + 两级阴影、单一强调色。
//
// 颜色这类无逗号 token 用 CSS 自定义属性（:root + 深色媒体查询）；
// 阴影这类带逗号的值一律写成 Stylus 变量再落到属性上，避免 Stylus 解析自定义属性里的逗号。
// ============================================================

:root {
  --ink: #1d1d1f;          // 标题、需要压住一切的正文
  --ink-soft: #424245;     // 正文
  --muted: #86868b;        // 次要信息：时间、分类、说明
  --hairline: #e8e8ed;     // 只用于表格和输入框，不再当卡片分割线
  --surface: #ffffff;      // 卡片
  --surface-2: #f5f5f7;    // 卡片内的次级色块、hover 底
  --accent: #0071e3;
  --accent-ink: #ffffff;
  --radius-lg: 20px;
  --radius-md: 14px;
  --radius-pill: 980px;
  --ease: cubic-bezier(.25, .1, .25, 1);
}

if (hexo-config('darkmode')) {
  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #f5f5f7;
      --ink-soft: #d2d2d7;
      --muted: #98989d;
      --hairline: #38383a;
      --surface: #1c1c1e;
      --surface-2: #2c2c2e;
      --accent: #6cb6ff;
      --accent-ink: #000000;
    }
  }
}

// 深色下主题的浅阴影看不见，卡片改用重阴影（选择器与主题 _schemes/Pisces 里的三块卡片对齐）
if (hexo-config('darkmode')) {
  @media (prefers-color-scheme: dark) {
    header.header {
      box-shadow: $shadow-dark;
    }

    .main-inner {
      box-shadow: $shadow-dark;
    }

    +desktop() {
      .sidebar-inner {
        box-shadow: $shadow-dark;
      }
    }
  }
}

// ---------------------------------------------------------------
// 排版基座：字体平滑、数字等宽、链接去掉那条下边框
// ---------------------------------------------------------------
body {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  -webkit-tap-highlight-color: transparent;
  text-rendering: optimizeLegibility;
}

a {
  border-bottom: 0;
  transition: color $transition-ease;

  &:hover {
    border-bottom-color: transparent;
  }
}

h1, h2, h3, h4, h5, h6 {
  color: var(--ink);
  font-weight: 600;
  letter-spacing: -.014em;
}

// ---------------------------------------------------------------
// 卡片外观：主内容区 / 侧栏 / 头部三块圆角卡，去掉 post-eof 那条分割线
// ---------------------------------------------------------------
.post-eof {
  display: none;
}

.post-block:first-of-type {
  padding-top: 0;
}

// ---------------------------------------------------------------
// 头部：原来是一整块饱和色 banner（--theme-color 底 + 白字），换成干净的左对齐标题
// ---------------------------------------------------------------
.site-brand-container {
  background: transparent;
}

.site-meta {
  padding: 22px 20px 10px;
  text-align: left;
}

.brand {
  color: var(--ink);

  &:hover {
    color: var(--accent);
  }

  .logo-line {
    display: none;   // 标题两侧那两道装饰斜线
  }
}

.site-title {
  font-size: 1.125em;
  font-weight: 600;
  letter-spacing: -.02em;
}

.site-subtitle {
  color: var(--muted);
  margin: 4px 0 0;
  text-align: left;
}

.site-nav-toggle .toggle, .site-nav-right .toggle {
  color: var(--ink);

  .toggle-line {
    background: currentColor;
  }
}

// 菜单：竖排胶囊项，选中/hover 用次级色块，不靠小圆点
.menu {
  padding: 0 12px 12px;
}

.menu .menu-item {
  margin: 2px 0;

  a {
    border-radius: var(--radius-pill);
    color: var(--ink-soft);
    font-size: .9375em;
    font-weight: 500;
    padding: 7px 14px;
    transition: background-color $transition-ease, color $transition-ease;

    &:hover, &.menu-item-active {
      background: var(--surface-2);
      color: var(--ink);
    }
  }

  .badge {
    background: var(--hairline);
    border-radius: var(--radius-pill);
    color: var(--muted);
    text-shadow: none;
  }
}

// ---------------------------------------------------------------
// 文章页：标题左对齐、去掉 hover 划线动画，正文层级靠字重与留白
// ---------------------------------------------------------------
.posts-expand {
  .post-header {
    margin-bottom: 32px;
    text-align: left;
  }

  .post-title {
    font-size: 1.9em;
    font-weight: 600;
    line-height: 1.25;
  }

  .post-title-link {
    color: var(--ink);

    &::before {
      display: none;
    }

    &:hover {
      color: var(--accent);
    }
  }
}

.post-meta {
  color: var(--muted);
  font-feature-settings: 'tnum' 1;
  font-variant-numeric: tabular-nums;

  a {
    color: var(--muted);

    &:hover {
      color: var(--accent);
    }
  }
}

.post-body {
  color: var(--ink-soft);

  p {
    margin: 0 0 1.2em;
  }

  h2 {
    margin: 2.2em 0 .8em;
  }

  h3, h4 {
    margin: 1.8em 0 .6em;
  }

  > :first-child {
    margin-top: 0;
  }

  img, video {
    border-radius: var(--radius-md);
    margin-bottom: 16px;
  }

  table {
    font-feature-settings: 'tnum' 1;
    font-variant-numeric: tabular-nums;

    th {
      color: var(--muted);
      font-weight: 600;
    }
  }

  blockquote {
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--muted);
    padding: 12px 20px;
  }

  // 正文里的链接：静止不下划线，hover 才出现，颜色本身就是可点击的提示
  a {
    color: var(--accent);

    &:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
}

// 按钮（阅读全文、提交等）：胶囊 + 轻微上浮
.post-button {
  margin-top: 20px;
}

.btn, .post-button .btn {
  border-radius: var(--radius-pill);
  font-weight: 500;
  letter-spacing: -.01em;
  padding: 9px 22px;
  transition: background-color $transition-ease, box-shadow $transition-ease, transform $transition-ease;

  &:hover {
    box-shadow: 0 6px 18px rgba(0, 113, 227, .28);
    transform: translateY(-1px);
  }
}

.pagination {
  a, .page-number {
    border-color: transparent;
    border-radius: var(--radius-pill);
    transition: background-color $transition-ease, color $transition-ease;
  }

  a:hover {
    background: var(--surface-2);
    border-color: transparent;
  }

  .page-number.current {
    background: var(--accent);
    color: var(--accent-ink);
  }
}

// ---------------------------------------------------------------
// 移动端头部：吸顶 + 毛玻璃（桌面端头部是左栏里的一张卡，不动它，避免盖住正文）
// ---------------------------------------------------------------
+tablet-mobile() {
  header.header {
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    background: rgba(255, 255, 255, .78);
    border-radius: 0;
    position: sticky;
    top: 0;
    z-index: $zindex-3;
  }
}

if (hexo-config('darkmode')) {
  @media (prefers-color-scheme: dark) {
    +tablet-mobile() {
      header.header {
        background: rgba(28, 28, 30, .78);
      }
    }
  }
}

// ---------------------------------------------------------------
// 行测「点击揭晓答案」：details 折叠，静止时只有一颗胶囊，展开后是次级色块
// ---------------------------------------------------------------
details.answer {
  margin: 0 0 1.4em;

  // 折叠按钮的文案来自 HTML 里的 <summary>，CSS 不再 ::before 补字，免得两处对不上
  > summary {
    background: var(--surface-2);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    color: var(--muted);
    cursor: pointer;
    display: inline-block;
    font-size: .875em;
    font-weight: 500;
    list-style: none;
    padding: 5px 14px;
    transition: background-color $transition-ease, border-color $transition-ease, color $transition-ease;
    user-select: none;
    -webkit-user-select: none;

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-ink);
    }
  }

  &[open] > summary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  // Chrome 靠 `::details-content { content-visibility: hidden }` 隐藏折叠内容：布局盒子还在，
  // 只是不画（getBoundingClientRect 会量到高度，checkVisibility() 才是 false）。
  // 这里显式 display:none，一是换掉那个占位盒子，二是让不支持该伪元素的内核也真的藏住。
  > .answer-body {
    display: none;
  }

  &[open] > .answer-body {
    display: block;
  }

  .answer-body {
    background: var(--surface-2);
    border-radius: var(--radius-md);
    margin-top: 10px;
    padding: 14px 18px;

    p:last-child {
      margin-bottom: 0;
    }
  }
}

// ---------------------------------------------------------------
// 首页 Bento 栅格（数据 scripts/bento-home.js，模板 tools/bento-home.njk）
// 只在首页这一块作用域里，卡片之间靠网格与色差分格，卡内不再画分割线
// ---------------------------------------------------------------
.bento-grid {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(6, 1fr);
}

.bento-card {
  background: var(--surface-2);
  border-radius: var(--radius-lg);
  grid-column: span 2;
  padding: 26px;
  transition: transform $transition-ease, box-shadow $transition-ease;

  &:hover {
    box-shadow: $shadow-float;
    transform: translateY(-2px);
  }
}

// 热力图与「最近更新」都整行铺；三张模块卡一行三张
.bento-card--heat,
.bento-card--feed {
  grid-column: span 6;
}

.bento-card--empty {
  background: transparent;
  border: 1px dashed var(--hairline);

  .bento-name {
    color: var(--muted);
  }

  &:hover {
    box-shadow: none;
    transform: none;
  }
}

.bento-kicker {
  color: var(--muted);
  font-feature-settings: 'tnum' 1;
  font-size: .8125em;
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  letter-spacing: .02em;
  margin: 0 0 8px;
}

.bento-name {
  font-size: 1.3em;
  margin: 0;

  a {
    color: var(--ink);

    &:hover {
      color: var(--accent);
    }
  }
}

.bento-blurb {
  color: var(--ink-soft);
  font-size: .9375em;
  line-height: 1.7;
  margin: 10px 0 0;
}

// ---------------------------------------------------------------
// 首页按月热度：一格 = 一个月，柱子高度 = 当月入库篇数 ÷ 最高月份
// 纯 CSS 静态渲染（数据 scripts/bento-home.js、模板 tools/bento-home.njk），没有 JS 和动画
// ---------------------------------------------------------------
.months {
  align-items: end;
  display: flex;
  gap: 8px;
}

.month-col {
  align-items: center;
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  gap: 6px;
  // 12 列靠 flex 收缩，不写 min-width:0 的话「10月」这种两字标签会把列撑破
  min-width: 0;
}

.month-count {
  color: var(--muted);
  font-feature-settings: 'tnum' 1;
  font-size: .75em;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  // 空月份不写字也占一行，12 根柱子的顶端才齐平
  min-height: 1.2em;
}

.month-track {
  align-items: end;
  background: var(--surface-2);
  border-radius: 6px;
  display: flex;
  height: 104px;
  overflow: hidden;
  width: 100%;
}

.month-bar {
  background: var(--accent);
  border-radius: 6px 6px 0 0;
  display: block;
  width: 100%;
}

.month-name {
  color: var(--muted);
  font-size: .75em;
  white-space: nowrap;
}

.heat-foot {
  align-items: center;
  color: var(--muted);
  display: flex;
  flex-wrap: wrap;
  font-feature-settings: 'tnum' 1;
  font-size: .75em;
  gap: 8px;
  justify-content: space-between;
  margin-top: 12px;
}

.bento-kids {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  list-style: none;
  margin: 16px 0 0;
  padding: 0;

  a {
    align-items: center;
    background: var(--surface);
    border-radius: var(--radius-pill);
    color: var(--ink-soft);
    display: inline-flex;
    font-size: .875em;
    font-weight: 500;
    gap: 7px;
    padding: 5px 13px;
    transition: background-color $transition-ease, color $transition-ease;

    &:hover {
      background: var(--accent);
      color: var(--accent-ink);

      .bento-count {
        color: var(--accent-ink);
        opacity: .75;
      }
    }
  }
}

.bento-count {
  color: var(--muted);
  font-feature-settings: 'tnum' 1;
  font-size: .8125em;
  font-variant-numeric: tabular-nums;
}

.bento-more {
  align-items: center;
  color: var(--accent);
  display: inline-flex;
  font-size: .9375em;
  font-weight: 500;
  gap: 7px;
  margin-top: 18px;

  i {
    font-size: .8em;
  }
}

.bento-feed {
  list-style: none;
  margin: 10px 0 0;
  padding: 0;

  li {
    align-items: baseline;
    border-bottom: 1px solid var(--hairline);
    display: grid;
    gap: 14px;
    grid-template-columns: 48px 1fr auto;
    padding: 11px 0;
  }

  li:last-child {
    border-bottom: 0;
  }

  time {
    color: var(--muted);
    font-feature-settings: 'tnum' 1;
    font-size: .8125em;
    font-variant-numeric: tabular-nums;
  }
}

.bento-feed-title {
  color: var(--ink);
  font-weight: 500;
  overflow-wrap: break-word;

  &:hover {
    color: var(--accent);
  }
}

.bento-tag {
  background: var(--surface);
  border-radius: var(--radius-pill);
  color: var(--muted);
  font-size: .75em;
  padding: 2px 9px;
  white-space: nowrap;
}

+tablet-mobile() {
  .bento-grid {
    grid-template-columns: 1fr;
  }

  .bento-card, .bento-card--heat, .bento-card--feed {
    grid-column: auto;
    grid-row: auto;
    padding: 22px;
  }

  // 手机上格子缩一点，52 周还是靠横向滑动看，不硬塞进屏宽
  .months {
    gap: 4px;
  }

  .month-track {
    height: 72px;
  }
}

// ---------------------------------------------------------------
// 侧栏目录：课（h2）常显，课内小标题（h3）默认折叠，点课名才展开
// 展开的类 .toc-open 由 source/js/toc-fold.js 加，--height 也是它按真实内容高度写的。
// _config.next.yml 里 toc.expand_all 设成 true，主题那套「滚到哪个课就自动撑开哪个」的
// 折叠 CSS 整块不再输出，所以这里的 .nav-child 是全站唯一一套，不用和主题抢优先级。
// 层级靠字重、缩进和小标题左边那条竖线，不画分割线。
// ---------------------------------------------------------------
.post-toc {
  .nav {
    padding-left: 2px;

    // 长标题换行：主题默认 nowrap + 省略号，240px 的侧栏里一门课的名字只显示半截
    .nav-item {
      line-height: 1.45;
      overflow: visible;
      text-overflow: clip;
      white-space: normal;
    }

    a {
      border-bottom: 0;
      border-radius: 8px;
      color: var(--ink-soft);
      display: block;
      padding: 6px 8px;
      transition: background-color .2s var(--ease), color .2s var(--ease);
    }

    a:hover {
      background: var(--surface-2);
      color: var(--ink);
    }

    // 课
    > .nav-item {
      margin-bottom: 1px;

      > a {
        font-weight: 600;
      }
    }

    .nav-child {
      --height: 0;
      height: 0;
      opacity: 0;
      overflow: hidden;
      transition: height .28s var(--ease), opacity .2s var(--ease), visibility .28s;
      visibility: hidden;
    }

    .toc-open > .nav-child {
      height: var(--height, auto);
      opacity: 1;
      visibility: visible;
    }

    // 小标题：缩进 + 竖线表示「属于上面那门课」
    .nav-child > .nav-item > a {
      border-left: 2px solid var(--hairline);
      border-radius: 0 8px 8px 0;
      color: var(--muted);
      font-size: .95em;
      margin-left: 14px;
      padding: 4px 8px 4px 12px;
    }

    // 箭头：只有带小标题的课才有（JS 给这些条目加 .toc-parent）
    .toc-parent > a {
      padding-left: 22px;
      position: relative;

      &::before {
        border-bottom: 1.6px solid var(--muted);
        border-right: 1.6px solid var(--muted);
        content: '';
        height: 6px;
        left: 8px;
        margin-top: -4px;
        position: absolute;
        top: 50%;
        transform: rotate(-45deg);
        transition: transform .2s var(--ease);
        width: 6px;
      }
    }

    .toc-parent.toc-open > a::before {
      transform: rotate(45deg);
    }

    // 当前读到哪：只换颜色，不再自动撑开（那正是原来侧栏自己跳动的原因）
    .active > a,
    .active-current > a {
      color: var(--accent);
    }

    .nav-child > .active > a {
      background: var(--surface-2);
    }
  }
}

// ---------------------------------------------------------------
// 顶部阅读进度条：主题自带（_config.next.yml 的 reading_progress），
// 颜色跟着 --accent 走，深色模式自动换成浅蓝，不用配置里写死的那个 hex
// ---------------------------------------------------------------
.reading-progress-bar {
  background: var(--accent);
}

// ---------------------------------------------------------------
// 侧栏「本模块文章」：文章页里把主题的站点概览（作者名 / 日志统计 / GitHub 链接）整块让位，
// 换成当前篇所在模块的兄弟篇（模板 tools/sidebar-module.njk，数据 scripts/module-nav.js）。
// .module-nav 只在文章页渲染出来，所以 :has() 这个条件波及不到首页和分类页；
// 格子标签「站点概览 → 本模块文章」由 source/js/sidebar-module.js 改，判断依据同上。
// ---------------------------------------------------------------
.site-overview-wrap:has(.module-nav) {
  > :not(.module-nav) {
    display: none;
  }
}

.module-nav {
  color: var(--ink-soft);
  font-size: .9375em;
  text-align: left;

  .module-nav-head {
    align-items: baseline;
    display: flex;
    gap: 8px;
    margin: 0 0 10px;
  }

  // 模块名就是该模块的分类页，右下角那颗数字是这一栏的总篇数
  .module-nav-title {
    color: var(--ink);
    font-weight: 600;

    &:hover {
      color: var(--accent);
    }
  }

  .module-nav-count {
    color: var(--muted);
    flex: none;
    font-feature-settings: 'tnum' 1;
    font-size: .85em;
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }

  // 组名（题型 / 月份）：点一下展开，样式跟侧栏目录的课保持一致
  .module-nav-group {
    align-items: baseline;
    background: none;
    border: 0;
    color: var(--muted);
    cursor: pointer;
    display: flex;
    font-family: inherit;
    font-size: .85em;
    letter-spacing: .02em;
    margin-top: 12px;
    padding: 2px 8px;
    width: 100%;

    &:hover {
      color: var(--ink);
    }

    &::before {
      border-bottom: 1.6px solid currentColor;
      border-right: 1.6px solid currentColor;
      content: '';
      flex: none;
      height: 5px;
      margin-right: 8px;
      transform: rotate(-45deg);
      transition: transform .2s var(--ease);
      width: 5px;
    }
  }

  .is-open > .module-nav-group {
    color: var(--ink-soft);

    &::before {
      transform: rotate(45deg);
    }
  }

  .module-nav-list {
    --height: auto;
    height: 0;
    margin: 0;
    overflow: hidden;
    padding-left: 0;
    // visibility 一并收起：收起的组只是看不见了，链接还留在键盘 Tab 顺序里很怪
    transition: height .28s var(--ease), visibility .28s;
    visibility: hidden;

    li {
      list-style: none;
      margin: 0;
    }

    a {
      border-radius: 8px;
      color: var(--ink-soft);
      display: block;
      line-height: 1.45;
      padding: 5px 8px;
      transition: background-color .2s var(--ease), color .2s var(--ease);
    }

    a:hover {
      background: var(--surface-2);
      color: var(--ink);
    }
  }

  .is-open > .module-nav-list {
    height: var(--height);
    visibility: visible;
  }

  // 没有第三层分类的模块（素描）没有组，列表直接挂在 .module-nav 下面，不参与折叠
  > .module-nav-list {
    height: auto;
    visibility: visible;
  }

  // 当前这篇：左边一条竖线 + 强调色，不画分割线
  .module-nav-list .is-current > a {
    background: var(--surface-2);
    border-left: 2px solid var(--accent);
    border-radius: 0 8px 8px 0;
    color: var(--accent);
    font-weight: 600;
    margin-left: 2px;
    padding-left: 14px;
  }
}

// ---------------------------------------------------------------
// 一键到顶：主题自带（_config.next.yml 的 back2top），点击和滚过 5% 才显出来
// 都是 source/js/utils.js 现成的（.back-to-top-on），这里只搬到右下角、放大成圆角按钮。
// 原来它在 desktop 上是 left:30px 的一颗 26px 深灰小块——正好压在 240px 宽的侧栏上，看不见。
// ---------------------------------------------------------------
.back-to-top {
  background: var(--surface);
  border: 1px solid var(--hairline);
  border-radius: var(--radius-md);
  bottom: -100px;
  box-shadow: $shadow-soft;
  color: var(--ink-soft);
  height: 42px;
  left: auto;
  opacity: 1;
  right: 30px;
  transition-property: bottom, color, border-color;
  width: 42px;

  &:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  // 图标带主题的 .fa-lg（1.333em），选择器多写一层才压得住它，别让箭头顶出按钮
  i.fa {
    font-size: 16px;
    line-height: 1;
    text-align: center;
    width: auto;
  }
}

.back-to-top.back-to-top-on {
  bottom: 30px;
}

+tablet-mobile() {
  .back-to-top {
    right: 20px;
  }
}

// ---------------------------------------------------------------
// 无障碍：用户要求减少动效时，主题的入场动画（animate.css）直接落到终态
// ---------------------------------------------------------------
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
}
